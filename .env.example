# Local loopback needs no password. Required for any remote/Cloudflare deployment.
# Set with: npx wrangler secret put BESIDE_PASSWORD
# Use a unique passphrase, at least 16 characters.
BESIDE_PASSWORD=
# API mode is separately billed, explicitly enabled in Settings, and optional.
BESIDE_API_KEY=
BESIDE_API_MODEL=gpt-4.1-mini
# API daily request/output limits are also enforced server-side.
# Local port defaults to 3000. Host is deliberately fixed to 127.0.0.1.
PORT=3000

# Enable only for a confirmed eligible OSS installation or approved private client.
# Cloudflare hosted deployments do not use this local flow. See docs/CHATGPT.md.
BESIDE_PLAN_ELIGIBLE=false
