{
  "name": "beside-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/local.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/local.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/server/worker-local.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "plan:transfer": "tsx scripts/plan-transfer.ts",
    "format": "prettier --write src tests scripts migrations *.ts *.json *.jsonc *.md docs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@huggingface/transformers": "4.3.1",
    "@js-temporal/polyfill": "^0.5.1",
    "hono": "^4.10.0",
    "ical.js": "^2.2.1",
    "jose": "^6.2.12",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  }
}
